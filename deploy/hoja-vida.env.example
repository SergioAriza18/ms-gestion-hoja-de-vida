# Perfil y puerto interno del contenedor
SPRING_PROFILES_ACTIVE=prod
HOJA_VIDA_SERVER_PORT=8080

# Origen HTTPS exacto del frontend desplegado. Separe varios orígenes con coma.
HOJA_VIDA_CORS_ALLOWED_ORIGINS=https://frontend.ejemplo.edu.co

# Debe ser la misma clave Base64 de al menos 64 bytes usada por autenticación para HS512.
# No almacene el valor real en este archivo ni en el repositorio.
HOJA_VIDA_JWT_SECRET=REEMPLAZAR_EN_EL_SERVIDOR

# Use el DNS/IP privado de MySQL; dentro del contenedor no utilice localhost.
HOJA_VIDA_DB_URL=jdbc:mysql://mysql.ejemplo.interno:3306/maestriacomputacion_HV?useSSL=true&serverTimezone=America/Bogota
HOJA_VIDA_DB_USERNAME=REEMPLAZAR_EN_EL_SERVIDOR
HOJA_VIDA_DB_PASSWORD=REEMPLAZAR_EN_EL_SERVIDOR

# Microservicio que provee homologaciones y cancelaciones.
# Si está en Docker, use su nombre DNS interno; no utilice localhost.
HOJA_VIDA_SOLICITUDES_URL=http://gestion-solicitudes:8095/msmaestriac
HOJA_VIDA_SOLICITUDES_CONNECT_TIMEOUT=5s
HOJA_VIDA_SOLICITUDES_READ_TIMEOUT=15s

# Carga de resoluciones PDF
HOJA_VIDA_RESOLUTION_MAX_SIZE=5MB
HOJA_VIDA_MAX_REQUEST_SIZE=6MB

# Pool de conexiones y cierre controlado
HOJA_VIDA_DB_POOL_MAX_SIZE=10
HOJA_VIDA_DB_POOL_MIN_IDLE=2
HOJA_VIDA_DB_CONNECTION_TIMEOUT=30000
HOJA_VIDA_DB_VALIDATION_TIMEOUT=5000
HOJA_VIDA_SHUTDOWN_TIMEOUT=30s
