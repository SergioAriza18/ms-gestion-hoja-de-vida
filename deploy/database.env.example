# Base de datos que se creara dentro del contenedor.
MYSQL_DATABASE=maestriacomputacion_HV

# Usuario exclusivo de los microservicios. No use root.
MYSQL_USER=hoja_vida_app
MYSQL_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# Clave administrativa exclusiva de MySQL.
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_PASSWORD_ROOT_SEGURO

# Puerto de acceso desde Windows/Workbench. El puerto interno sigue siendo 3306.
MYSQL_PORT=3307
